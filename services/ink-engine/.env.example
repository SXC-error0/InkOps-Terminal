# InkOps Terminal - Ink Engine 配置模板
# 复制此文件为 .env 并填入你的配置

# LLM Provider (兼容 OpenAI 协议)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# 服务端口
INK_ENGINE_PORT=8700
INK_ENGINE_HOST=127.0.0.1

# 日志级别
LOG_LEVEL=INFO

# GitHub (可选, Terminal 模块需要)
GITHUB_TOKEN=
GITHUB_USERNAME=
